# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/crm_db"

# Google Drive webhook token
GDRIVE_WEBHOOK_TOKEN=change-this-to-a-random-secret

# Google service-account key as compact, single-line JSON.
# Share the Drive import folder with its client_email as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-google-cloud-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"crm-drive-import@your-google-cloud-project.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
# Optional: when set, successful imports are also appended to this spreadsheet.
GOOGLE_SHEETS_ID=

# Python extraction pipeline (inside Docker: /app/extraction)
PYTHON_VENV_PATH=/usr/bin/python3
EXTRACTION_DIR=/app/extraction

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# Notify cron endpoint secret
NOTIFY_SECRET=your-random-notify-secret

# Google OAuth — NextAuth (restrict to @sakww.com)
AUTH_SECRET=your-random-auth-secret
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
